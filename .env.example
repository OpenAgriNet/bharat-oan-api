TELEMETRY_API_URL=https://dev-vistaar.da.gov.in/observability-service/action/data/v3/telemetry
TELEMETRY_ORIGIN=https://dev-vistaar.da.gov.in
TELEMETRY_REFERER=https://dev-vistaar.da.gov.in/chat
TELEMETRY_CHANNEL=BharatVistaar-https://dev-vistaar.da.gov.in
TELEMETRY_AUTH_TOKEN=
TELEMETRY_AUTH_KEY=
TELEMETRY_AUTH_SECRET=

# NPSS image analysis
NPSS_BASE_URL=https://npss.dac.gov.in/api3.0
NPSS_USERNAME=
NPSS_PASSWORD=

# --- Model registry: define each model once under MODEL_<ALIAS>_*, fully self
# contained (every field lives under its own alias, nothing is ever inherited
# from another alias or another use case). Then point any use case at any
# alias by name below -- mixing kinds freely (e.g. moderation on a local vLLM
# box while agrinet uses an external gateway) is just naming two different
# aliases, no code change either way. Kind is one of: openai | vllm | external
# | azure-openai.

MODEL_GPT41_KIND=openai
MODEL_GPT41_MODEL_NAME=gpt-4.1
MODEL_GPT41_API_KEY=

# MODEL_GPT4O_MINI_KIND=openai
# MODEL_GPT4O_MINI_MODEL_NAME=gpt-4o-mini
# MODEL_GPT4O_MINI_API_KEY=

# --- vllm (a plain vLLM server you run yourself, no auth/gateway needed) ---
# MODEL_GEMMA_KIND=vllm
# MODEL_GEMMA_MODEL_NAME=google/gemma-4-31b-it
# MODEL_GEMMA_BASE_URL=http://localhost:8000/v1

# --- external (an OpenAI-compatible endpoint behind a gateway, e.g. needing
# extra auth headers or a body field like serviceId beyond the standard spec) ---
# MODEL_GEMMA_GATEWAY_KIND=external
# MODEL_GEMMA_GATEWAY_MODEL_NAME=google/gemma-4-31b-it
# MODEL_GEMMA_GATEWAY_BASE_URL=https://your-gateway.example.com/api/v1
# MODEL_GEMMA_GATEWAY_API_KEY=
# MODEL_GEMMA_GATEWAY_EXTRA_HEADERS_JSON={"X-API-Key": "...", "x-auth-source": "BOTH"}
# MODEL_GEMMA_GATEWAY_EXTRA_BODY_JSON={"serviceId": "..."}
# MODEL_GEMMA_GATEWAY_DISABLE_STREAMING=false   # set true if the gateway's SSE streaming is non-compliant

# --- azure-openai ---
# MODEL_AZURE_GPT4_KIND=azure-openai
# MODEL_AZURE_GPT4_DEPLOYMENT_NAME=
# MODEL_AZURE_GPT4_ENDPOINT=
# MODEL_AZURE_GPT4_API_KEY=
# MODEL_AZURE_GPT4_API_VERSION=

# --- Wiring: which model alias backs each use case ---
AGRINET_MODEL_ALIAS=GPT41
MODERATION_MODEL_ALIAS=GPT41
# AGRINET_ROUTE_GEMMA_MODEL_ALIAS=GEMMA   # only used if AGRINET routing (A/B) is enabled
