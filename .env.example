TELEMETRY_API_URL=https://dev-vistaar.da.gov.in/observability-service/action/data/v3/telemetry
TELEMETRY_ORIGIN=https://dev-vistaar.da.gov.in
TELEMETRY_REFERER=https://dev-vistaar.da.gov.in/chat
TELEMETRY_CHANNEL=BharatVistaar-https://dev-vistaar.da.gov.in
TELEMETRY_AUTH_TOKEN=
TELEMETRY_AUTH_KEY=
TELEMETRY_AUTH_SECRET=

# NPSS image analysis
NPSS_BASE_URL=https://npss.dac.gov.in/api3.0
NPSS_USERNAME=
NPSS_PASSWORD=

# LLM provider -- one of: openai | vllm | external | azure-openai
# Selects which block below is active for both the AGRINET and MODERATION roles.
LLM_PROVIDER=openai

# --- openai ---
OPENAI_API_KEY=
LLM_AGRINET_MODEL_NAME=gpt-4.1
LLM_MODERATION_MODEL_NAME=gpt-4o-mini

# --- vllm (a plain vLLM server you run yourself, no auth/gateway needed) ---
# LLM_AGRINET_MODEL_NAME=google/gemma-4-31b-it
# LLM_MODERATION_MODEL_NAME=google/gemma-4-31b-it
# VLLM_MODEL_URL=http://localhost:8000/v1
# VLLM_MODERATION_MODEL_URL=   # optional -- only set if moderation should use a different server

# --- external (an OpenAI-compatible endpoint behind a gateway, e.g. needing
# extra auth headers or a body field like serviceId beyond the standard spec) ---
# EXTERNAL_MODEL_NAME=google/gemma-4-31b-it
# EXTERNAL_BASE_URL=https://your-gateway.example.com/api/v1
# EXTERNAL_API_KEY=
# EXTERNAL_EXTRA_HEADERS_JSON={"X-API-Key": "...", "x-auth-source": "BOTH"}
# EXTERNAL_EXTRA_BODY_JSON={"serviceId": "..."}
# EXTERNAL_DISABLE_STREAMING=false   # set true if the gateway's SSE streaming is non-compliant
#
# moderation inherits everything above automatically -- only set these if it must differ:
# EXTERNAL_MODERATION_MODEL_NAME=
# EXTERNAL_MODERATION_BASE_URL=
# EXTERNAL_MODERATION_API_KEY=
# EXTERNAL_MODERATION_EXTRA_HEADERS_JSON=
# EXTERNAL_MODERATION_EXTRA_BODY_JSON=

# --- azure-openai ---
# AZURE_OPENAI_DEPLOYMENT_NAME=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=
# LLM_AGRINET_MODEL_NAME=       # optional, falls back to AZURE_OPENAI_DEPLOYMENT_NAME
# LLM_MODERATION_MODEL_NAME=    # optional, falls back to AZURE_OPENAI_DEPLOYMENT_NAME
