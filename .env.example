TELEMETRY_API_URL=https://dev-vistaar.da.gov.in/observability-service/action/data/v3/telemetry
TELEMETRY_ORIGIN=https://dev-vistaar.da.gov.in
TELEMETRY_REFERER=https://dev-vistaar.da.gov.in/chat
TELEMETRY_CHANNEL=BharatVistaar-https://dev-vistaar.da.gov.in
TELEMETRY_AUTH_TOKEN=
TELEMETRY_AUTH_KEY=
TELEMETRY_AUTH_SECRET=

# NPSS image analysis
NPSS_BASE_URL=https://npss.dac.gov.in/api3.0
NPSS_USERNAME=
NPSS_PASSWORD=

# Location Resolver + IMD agromet DB
RESOLVER_URL=http://127.0.0.1:8001
RESOLVER_CALLBACK_URL=http://127.0.0.1:8000/api/resolver/on_resolve
RESOLVER_API_KEY=
RESOLVER_SUBSCRIBER_ID=bharat-vistaar
RESOLVER_WAIT_SECONDS=8
IMD_DB_URL=postgresql://postgres:postgres@localhost:5434/imd_agromet

# Capability policy: all, none, or comma-separated exact business tool names.
# Preloaded tools must be allowed. "all" here means all allowed tools.
CAPABILITY_ALLOWED_TOOLS=all
CAPABILITY_PRELOADED_TOOLS=all
# FFS: server-side only. Leave URL blank to keep calls unavailable.
FFS_BASE_URL=
FFS_ESA_KEY=
FFS_ESA_IV=
FFS_APP_VERSION=

# Voice (Sarvam calls POST /api/v1/chat/completions)
# false = accept requests without a bearer token (a token that is sent is still verified).
VOICE_AUTH_ENABLED=true
VOICE_HOLD_MESSAGE_ENABLED=true
VOICE_DELAY_MESSAGE_ENABLED=true
VOICE_DELAY_MESSAGE_AFTER_SECONDS=6.0
VOICE_HISTORY_TTL_SECONDS=3600
# Model split for calls = chat's AGRINET_ROUTING_ENABLED / AGRINET_PROPORTION_* (config/models.yaml).

# Voice telemetry: same endpoint as TELEMETRY_API_URL unless overridden; separate channel.
VOICE_TELEMETRY_API_URL=
VOICE_TELEMETRY_CHANNEL=BharatVistaar-https://dev-vistaar.da.gov.in
# Optional. Auth header is sent only when a token, or key + secret, is set.
VOICE_TELEMETRY_AUTH_TOKEN=
VOICE_TELEMETRY_AUTH_KEY=
VOICE_TELEMETRY_AUTH_SECRET=
VOICE_TELEMETRY_ORIGIN=
VOICE_TELEMETRY_REFERER=

# Voice Langfuse project: same LANGFUSE_HOST, different keys. Voice requests trace
# here; unset = voice traces go to the chat project.
VOICE_LANGFUSE_PUBLIC_KEY=
VOICE_LANGFUSE_SECRET_KEY=
