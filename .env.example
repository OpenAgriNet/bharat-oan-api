# Core MCP/dev connectivity
ENVIRONMENT=local
REDIS_HOST=sva_redis
REDIS_PORT=6379
MCP_SERVER_URL=http://vistaar_mcp:3001/mcp
MCP_TIMEOUT_SECONDS=120
USE_MEMORY_CACHE=false

# Telemetry
TELEMETRY_API_URL=https://dev-vistaar.da.gov.in/observability-service/action/data/v3/telemetry
TELEMETRY_ORIGIN=https://dev-vistaar.da.gov.in
TELEMETRY_REFERER=https://dev-vistaar.da.gov.in/chat
TELEMETRY_CHANNEL=BharatVistaar-https://dev-vistaar.da.gov.in
TELEMETRY_AUTH_TOKEN=
TELEMETRY_AUTH_KEY=
TELEMETRY_AUTH_SECRET=

# Agrinet routing
AGRINET_ROUTING_ENABLED=false
AGRINET_ROUTE_GPT41_WEIGHT=70
AGRINET_ROUTE_GEMMA_WEIGHT=30
AGRINET_ROUTE_TTL_SECONDS=7200
AGRINET_MODEL_TIMEOUT_SECONDS=45
AGRINET_GEMMA_PROVIDER=vllm
AGRINET_GEMMA_MODEL_NAME=
AGRINET_GEMMA_BASE_URL=
AGRINET_GEMMA_API_KEY=not-needed
